        android:strokeWidth="3.7"
        android:pathData="M43.3,33 H58.01 A2.4,2.4 0 0 1 59.7,33.7 L68.8,42.8 A2.4,2.4 0 0 1 69.5,44.49 V70.2 A4.8,4.8 0 0 1 64.7,75 H43.3 A4.8,4.8 0 0 1 38.5,70.2 V37.8 A4.8,4.8 0 0 1 43.3,33 Z" />
