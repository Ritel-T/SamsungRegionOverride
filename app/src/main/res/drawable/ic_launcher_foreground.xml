        android:strokeColor="#E6EDEE"
        android:strokeWidth="4.6"
        android:pathData="M41,28 H58.76 A3,3 0 0 1 60.88,28.88 L72.12,40.12 A3,3 0 0 1 73,42.24 V74 A6,6 0 0 1 67,80 H41 A6,6 0 0 1 35,74 V34 A6,6 0 0 1 41,28 Z" />
